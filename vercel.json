{
  "version": 2,
  "builds": [
    {
      "src": "api/audit.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/lead.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/subscribe.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/report-issue.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "frontend/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "frontend/sitemap.xml"
    },
    {
      "src": "/google3767930768036b5b.html",
      "dest": "frontend/google3767930768036b5b.html"
    },
    {
      "src": "/admin",
      "dest": "frontend/admin.html"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "api/admin.js"
    },
    {
      "src": "/api/admin",
      "dest": "api/admin.js"
    },
    {
      "src": "/api/audit",
      "dest": "api/audit.js"
    },
    {
      "src": "/api/lead",
      "dest": "api/lead.js"
    },
    {
      "src": "/api/payment/subscribe",
      "dest": "api/subscribe.js"
    },
    {
      "src": "/api/report-issue",
      "dest": "api/report-issue.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
