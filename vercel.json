    },
    {
      "path": "/api/lead-recovery",
      "schedule": "0 14 * * 2,3,5"
    },
    {
      "path": "/api/outreach?cadence=touch_2_roi",
      "schedule": "0 13 * * 4"
    }
  ]
}
