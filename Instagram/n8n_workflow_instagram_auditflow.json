{
  "name": "AuditFlow AI — Instagram Autonomous Publishing & DM Funnel Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-instagram-daily",
      "name": "Cron Diario 1:00 PM (Hora Pico Instagram B2B)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 200]
    },
    {
      "parameters": {
        "path": "instagram-publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-instagram-publish",
      "name": "Webhook: Despacho de Contenido Instagram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 400],
      "webhookId": "instagram-publish-auditflow"
    },
    {
      "parameters": {
        "path": "instagram-lead-webhook",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-instagram-comments",
      "name": "Webhook: Comentarios Instagram (Funnel Lead Magnet)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 750],
      "webhookId": "instagram-comments-lead-magnet"
    },
    {
      "parameters": {
        "jsCode": "// Normalizar payload de entrada para Instagram Publishing\nconst body = items[0].json.body || items[0].json;\n\nconst postType = (body.post_type || 'CAROUSEL').toUpperCase(); // CAROUSEL, REEL, IMAGE\nconst caption = body.caption || 'Protege tus finanzas y audita contratos en segundos con AuditFlow AI. 🚀\\n\\n🔗 Enlace en bio para tu auditoría gratuita.\\n\\n#AuditFlowAI #LegalTech #CFO #DerechoCorporativo #Compliance';\nconst mediaUrls = body.media_urls || [body.image_url || body.media_url || 'https://audiflowai.com/banner_audiflowai.png'];\nconst coverUrl = body.cover_url || '';\nconst igUserId = $env.INSTAGRAM_ACCOUNT_ID || '17841400000000000';\nconst accessToken = $env.INSTAGRAM_ACCESS_TOKEN || 'YOUR_GRAPH_API_LONG_LIVED_TOKEN';\n\nreturn [{\n  json: {\n    postType,\n    caption,\n    mediaUrls: Array.isArray(mediaUrls) ? mediaUrls : [mediaUrls],\n    coverUrl,\n    igUserId,\n    accessToken,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-payload-parser",
      "name": "Parsear & Validar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.postType }}",
              "operation": "equals",
              "value2": "CAROUSEL"
            }
          ]
        }
      },
      "id": "if-is-carousel",
      "name": "¿Es Carrusel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.postType }}",
              "operation": "equals",
              "value2": "REEL"
            }
          ]
        }
      },
      "id": "if-is-reel",
      "name": "¿Es Reel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [840, 420]
    },
    {
      "parameters": {
        "jsCode": "// Desglosar slides de carrusel para subir cada contenedor hijo\nconst mediaUrls = $node[\"Parsear & Validar Payload\"].json.mediaUrls;\nconst igUserId = $node[\"Parsear & Validar Payload\"].json.igUserId;\nconst accessToken = $node[\"Parsear & Validar Payload\"].json.accessToken;\n\nreturn mediaUrls.map((url, index) => ({\n  json: {\n    igUserId,\n    accessToken,\n    imageUrl: url,\n    isCarouselItem: true,\n    slideIndex: index\n  }\n}));"
      },
      "id": "code-split-carousel-slides",
      "name": "Preparar Slides de Carrusel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.igUserId }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.imageUrl }}"
            },
            {
              "name": "is_carousel_item",
              "value": "true"
            },
            {
              "name": "access_token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-create-slide-container",
      "name": "Crear Contenedor Slide (Instagram API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 180]
    },
    {
      "parameters": {
        "jsCode": "// Agrupar IDs de contenedores hijos para el contenedor padre de Carrusel\nconst childIds = items.map(item => item.json.id);\nconst parentData = $node[\"Parsear & Validar Payload\"].json;\n\nreturn [{\n  json: {\n    igUserId: parentData.igUserId,\n    accessToken: parentData.accessToken,\n    caption: parentData.caption,\n    children: childIds.join(','),\n    mediaType: 'CAROUSEL'\n  }\n}];"
      },
      "id": "code-aggregate-carousel",
      "name": "Consolidar Contenedor Carrusel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.igUserId }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "CAROUSEL"
            },
            {
              "name": "children",
              "value": "={{ $json.children }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-create-carousel-parent",
      "name": "Crear Carrusel Padre (Instagram API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $node[\"Parsear & Validar Payload\"].json.igUserId }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.mediaUrls[0] }}"
            },
            {
              "name": "caption",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-create-reel-container",
      "name": "Crear Contenedor Reel (Instagram API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $node[\"Parsear & Validar Payload\"].json.igUserId }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.mediaUrls[0] }}"
            },
            {
              "name": "caption",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $node[\"Parsear & Validar Payload\"].json.accessToken }}"
