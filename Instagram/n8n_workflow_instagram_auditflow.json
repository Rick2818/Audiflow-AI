      "id": "http-create-single-image",
      "name": "Crear Contenedor Imagen Única",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 560]
    },
    {
      "parameters": {
        "jsCode": "// Extraer el creation_id listo para publicación\nconst containerId = items[0].json.id;\nconst parentData = $node[\"Parsear & Validar Payload\"].json;\n\nreturn [{\n  json: {\n    igUserId: parentData.igUserId,\n    accessToken: parentData.accessToken,\n    creationId: containerId\n  }\n}];"
      },
      "id": "code-extract-creation-id",
      "name": "Obtener Creation ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.igUserId }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.creationId }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-publish-to-instagram",
      "name": "Publicar en Instagram (Live Post)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2040, 360]
    },
    {
      "parameters": {
        "jsCode": "// Procesar comentarios con palabras clave ('REDLINE', 'AUDITORIA', 'PRECIO') para responder en DM\nconst commentData = items[0].json.body?.entry?.[0]?.changes?.[0]?.value || items[0].json;\nconst commentText = (commentData.text || '').toUpperCase();\nconst senderId = commentData.from?.id || commentData.user_id;\nconst commentId = commentData.id;\n\nconst isTargetKeyword = commentText.includes('REDLINE') || commentText.includes('AUDITORIA') || commentText.includes('DEMO') || commentText.includes('INFO');\n\nconst dmMessage = `¡Hola! 👋 Gracias por tu interés en AuditFlow AI.\\n\\nAquí tienes tu acceso directo para auditar contratos y facturas en tiempo real:\\n👉 https://audiflowai.com/demo\\n\\nSi requieres soporte fiduciario o cotización corporativa ($599/año), escríbenos directamente aquí.`;\n\nreturn [{\n  json: {\n    isTargetKeyword,\n    senderId,\n    commentId,\n    dmMessage,\n    accessToken: $env.INSTAGRAM_ACCESS_TOKEN || 'YOUR_GRAPH_API_LONG_LIVED_TOKEN'\n  }\n}];"
      },
      "id": "code-filter-comment-trigger",
      "name": "Filtrar Trigger de Comentario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 750]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isTargetKeyword }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-keyword-matches",
      "name": "¿Coincide Palabra Clave?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [600, 750]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/me/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipient\": { \"id\": \"{{ $json.senderId }}\" },\n  \"message\": { \"text\": \"{{ $json.dmMessage }}\" },\n  \"access_token\": \"{{ $json.accessToken }}\"\n}",
        "options": {}
      },
      "id": "http-send-automated-dm",
      "name": "Enviar DM Automático con Lead Magnet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 750]
    }
  ],
