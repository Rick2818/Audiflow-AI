# ==============================================================================
# AUDITFLOW AI - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# SERVIDOR Y PUERTO
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# MOTOR IA (GEMINI 2.5 FLASH)
GEMINI_API_KEY=your_gemini_2_5_flash_api_key_here

# BASE DE DATOS (SUPABASE)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PASARELA DE PAGO: STRIPE (USD $7.00 - Liquidación Bancaria)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# PASARELA DE PAGO: LIGHTNING NETWORK (OpenNode / Strike - Liquidación Sats)
LIGHTNING_PROVIDER=opennode # 'opennode' o 'strike'
OPENNODE_API_KEY=your_opennode_api_key_here
OPENNODE_WEBHOOK_SECRET=your_opennode_webhook_secret_here
STRIKE_API_KEY=your_strike_api_key_here
LIGHTNING_ADDRESS=user@stacker.news # Dirección Lightning de liquidación

# AGENTE DE CORREO (RESEND / SMTP)
EMAIL_PROVIDER=resend # 'resend' o 'smtp'
RESEND_API_KEY=re_123456789...
FROM_EMAIL=audits@auditflow.ai
