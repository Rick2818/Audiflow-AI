// ==============================================================================
// AUDITFLOW AI - AUTOMATED EMAIL AGENT (EmailAgent.bx)
// DISPARO DE REPORTE Y EMBUDO DE UPSELL CORPORATIVO ($49/MES) EN ESPAÑOL E INGLÉS
// ==============================================================================

class {

    private string function getResendApiKey() {
        return getSystemSetting("RESEND_API_KEY", "");
    }

    private string function getFromEmail() {
        return getSystemSetting("FROM_EMAIL", "audits@auditflow.ai");
    }

    private string function getAppUrl() {
        return getSystemSetting("APP_URL", "http://localhost:3000");
    }

    /**
     * Envío automático del reporte completo con oferta de Upsell Corporativo ($49/mes)
     * Soporta idiomas Bilingües: 'es' (Español) y 'en' (Inglés)
     */
    public boolean function sendFullReportEmail( 
        required string recipientEmail, 
        required string recipientName, 
        required struct reportData,
        string lang = "es"
    ) {
        var apiKey = getResendApiKey();
        var docName = structKeyExists(arguments.reportData, "document_name") ? arguments.reportData.document_name : "Documento.pdf";
        var isEn = (arguments.lang == "en");

        var subject = isEn 
            ? "🔒 Your Official Audit Report - AuditFlow AI [" & docName & "]"
            : "🔒 Tu Reporte Oficial de Auditoría - AuditFlow AI [" & docName & "]";
        
        var leadScore = 80;
        var summaryJson = structKeyExists(arguments.reportData, "summary_json") ? arguments.reportData.summary_json : {};
        if ( isJson(summaryJson) ) {
            summaryJson = deserializeJSON(summaryJson);
        }
        
        if ( isStruct(summaryJson) AND structKeyExists(summaryJson, "lead_score") ) {
            leadScore = val(summaryJson.lead_score);
        }
        
        var isEnterpriseCandidate = (leadScore >= 75);
        var leakageAmount = structKeyExists(arguments.reportData, "total_financial_leakage") ? val(arguments.reportData.total_financial_leakage) : 0;
        
        var findingsHtml = "";
        if ( isStruct(summaryJson) AND structKeyExists(summaryJson, "findings") AND isArray(summaryJson.findings) ) {
            var findingsList = summaryJson.findings;
            for ( var item in findingsList ) {
                var sev = structKeyExists(item, "severity") ? item.severity : "HIGH";
                var clauseRef = structKeyExists(item, "clause_reference") ? item.clause_reference : (isEn ? "Clause" : "Cláusula");
                var titleStr = structKeyExists(item, "title") ? item.title : (isEn ? "Detected Anomaly" : "Hallazgo Detectado");
                var impactVal = structKeyExists(item, "financial_impact") ? val(item.financial_impact) : 0;
                var solStr = structKeyExists(item, "actionable_solution") ? item.actionable_solution : "";

                var solLabel = isEn ? "Unlocked Tactical Solution:" : "Solución Táctica Desbloqueada:";
                var impactLabel = isEn ? "Financial Impact:" : "Impacto Financiero:";

                findingsHtml &= "
                <div style='background-color:#18181b; border:1px solid #27272a; border-radius:8px; padding:16px; margin-bottom:16px; color:#f4f4f5;'>
                    <div style='display:flex; justify-content:space-between; align-items:center;'>
                        <span style='color:#ef4444; font-weight:bold; font-size:14px;'>" & sev & "</span>
                        <span style='color:#a1a1aa; font-size:12px;'>" & clauseRef & "</span>
                    </div>
                    <h4 style='color:#ffffff; margin:8px 0 4px 0; font-size:16px;'>" & titleStr & "</h4>
                    <p style='color:#10b981; font-weight:bold; margin:0 0 8px 0;'>" & impactLabel & " $" & numberFormat(impactVal, ",.2f") & " USD</p>
                    <div style='background-color:#09090b; border-left:3px solid #10b981; padding:10px; margin-top:8px; border-radius:4px;'>
                        <strong style='color:#38bdf8; font-size:13px;'>" & solLabel & "</strong>
                        <p style='color:#e4e4e7; font-size:13px; margin:4px 0 0 0; line-height:1.5;'>" & solStr & "</p>
                    </div>
                </div>";
            }
        }

        // BLOQUE DE UPSELL CORPORATIVO ($49/MES) (BILINGÜE)
        var upsellHtml = "";
        if ( isEnterpriseCandidate ) {
            if ( isEn ) {
                upsellHtml = "
                <div style='background: linear-gradient(135deg, #2e1065 0%, #0f172a 100%); border:1px solid #7c3aed; border-radius:12px; padding:24px; margin:32px 0; text-align:center;'>
                    <span style='background-color:#7c3aed; color:#ffffff; font-size:10px; font-weight:bold; padding:4px 10px; border-radius:999px; text-transform:uppercase;'>Exclusive B2B Offer</span>
                    <h3 style='color:#ffffff; font-size:20px; margin:12px 0 8px 0;'>Do you audit multiple contracts per month?</h3>
                    <p style='color:#cbd5e1; font-size:13px; line-height:1.5; margin-bottom:20px;'>
                        Upgrade to <strong>Enterprise Subscription for $49/mo</strong>. Get unlimited RAM volatile audits, multi-user team access, and priority 24/7 legal support.
                    </p>
                    <a href='" & getAppUrl() & "/api/payment/subscribe?email=" & urlEncodedFormat(arguments.recipientEmail) & "' style='background:linear-gradient(135deg, #9333ea 0%, #0284c7 100%); color:#ffffff; font-weight:bold; text-decoration:none; padding:12px 28px; border-radius:8px; font-size:14px; display:inline-block;'>
                        🚀 Activate Enterprise Plan ($49/mo)
                    </a>
                </div>";
            } else {
                upsellHtml = "
                <div style='background: linear-gradient(135deg, #2e1065 0%, #0f172a 100%); border:1px solid #7c3aed; border-radius:12px; padding:24px; margin:32px 0; text-align:center;'>
                    <span style='background-color:#7c3aed; color:#ffffff; font-size:10px; font-weight:bold; padding:4px 10px; border-radius:999px; text-transform:uppercase;'>Oferta Corporativa Exclusiva</span>
                    <h3 style='color:#ffffff; font-size:20px; margin:12px 0 8px 0;'>¿Auditas múltiples contratos al mes en tu empresa?</h3>
                    <p style='color:#cbd5e1; font-size:13px; line-height:1.5; margin-bottom:20px;'>
                        Pasa a la suscripción <strong>Corporativa por $49/mes</strong>. Obtén auditorías ilimitadas en memoria volátil, acceso para tu equipo legal y soporte prioritario 24/7.
                    </p>
                    <a href='" & getAppUrl() & "/api/payment/subscribe?email=" & urlEncodedFormat(arguments.recipientEmail) & "' style='background:linear-gradient(135deg, #9333ea 0%, #0284c7 100%); color:#ffffff; font-weight:bold; text-decoration:none; padding:12px 28px; border-radius:8px; font-size:14px; display:inline-block;'>
                        🚀 Activar Suscripción Corporativa ($49/mes)
                    </a>
                </div>";
            }
        }

        var greeting = isEn ? "Hello" : "Hola";
        var subHeader = isEn ? "Official Volatile RAM Audit Report" : "Informe Oficial de Auditoría en Memoria Volátil";
        var confirmMsg = isEn 
            ? "Payment confirmed. Below is the complete audit report for <strong>" & htmlEditFormat(docName) & "</strong>."
            : "Pago confirmado con éxito. A continuación encontrarás el informe completo de <strong>" & htmlEditFormat(docName) & "</strong>.";
        var totalLeakageLabel = isEn ? "Total Financial Leakage Detected" : "Total Fuga Financiera Detectada";
        var solutionsTitle = isEn ? "Unlocked Tactical Solutions:" : "Soluciones Tácticas Desbloqueadas:";
        var footerText = isEn 
            ? "AuditFlow AI - Operating 24/7 with Zero File Storage."
            : "AuditFlow AI - Operando 24/7 con Cero Almacenamiento de Archivos.";

        var emailBodyHtml = "
        <!DOCTYPE html>
        <html>
        <head><meta charset='UTF-8'></head>
        <body style='font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; background-color:#09090b; color:#ffffff; padding:24px; margin:0;'>
            <div style='max-width:600px; margin:0 auto; background-color:#121215; border:1px solid #27272a; border-radius:12px; padding:32px;'>
                <div style='text-align:center; border-bottom:1px solid #27272a; padding-bottom:20px; margin-bottom:24px;'>
                    <h2 style='color:#38bdf8; margin:0; font-size:24px;'>AuditFlow AI</h2>
                    <p style='color:#71717a; font-size:12px; margin:4px 0 0 0;'>" & subHeader & "</p>
                </div>

                <p style='font-size:15px; color:#e4e4e7;'>" & greeting & " <strong>" & htmlEditFormat(arguments.recipientName) & "</strong>,</p>
                <p style='font-size:14px; color:#a1a1aa; line-height:1.6;'>" & confirmMsg & "</p>

                <div style='background-color:#18181b; border-radius:8px; padding:16px; margin:20px 0; text-align:center;'>
                    <span style='color:#a1a1aa; font-size:12px; text-transform:uppercase;'>" & totalLeakageLabel & "</span>
                    <h1 style='color:#ef4444; margin:4px 0 0 0; font-size:32px;'>$" & numberFormat(leakageAmount, ",.2f") & " USD</h1>
                </div>

                <h3 style='color:#ffffff; font-size:18px; margin-top:28px;'>" & solutionsTitle & "</h3>
                " & findingsHtml & "
                " & upsellHtml & "

                <div style='border-top:1px solid #27272a; margin-top:32px; padding-top:20px; text-align:center; color:#71717a; font-size:12px;'>
                    <p style='margin:0;'>" & footerText & "</p>
                </div>
            </div>
        </body>
        </html>";

        if ( len(trim(apiKey)) > 0 ) {
            try {
                var httpService = new http();
                httpService.setMethod("POST");
                httpService.setUrl("https://api.resend.com/emails");
                httpService.addParam(type="header", name="Authorization", value="Bearer " & apiKey);
                httpService.addParam(type="header", name="Content-Type", value="application/json");

                var payload = {
                    "from": getFromEmail(),
                    "to": [ arguments.recipientEmail ],
                    "subject": subject,
                    "html": emailBodyHtml
                };

                httpService.setBody( serializeJSON(payload) );
                var res = httpService.send().getPrefix();
                return (res.statusCode contains "200");
            } catch(any e) {
                systemOutput("[AuditFlow AI EmailAgent] Error enviando email vía Resend: " & e.message, true);
                return false;
            }
        }

        systemOutput("[AuditFlow AI EmailAgent] Email (" & arguments.lang & ") con Upsell enviado a: " & arguments.recipientEmail, true);
        return true;
    }
}
