// ==============================================================================
// AUDITFLOW AI - LIGHTNING NETWORK SERVICE (LightningService.bx)
// COBROS EN SATOSHIS VÍA OPENNODE / STRIKE CON EXPIRACIÓN DE 10 MINUTOS
// LIQUIDACIÓN DIRECTA A DIRECCIÓN LIGHTNING / NODO SIN CONVERSIÓN A FIAT
// ==============================================================================

class {

    private string function getOpenNodeKey() {
        return getSystemSetting("OPENNODE_API_KEY", "");
    }

    private string function getLightningAddress() {
        return getSystemSetting("LIGHTNING_ADDRESS", "audits@stacker.news");
    }

    /**
     * Obtiene la tasa spot actual de Bitcoin (USD -> Satoshis)
     */
    public numeric function getBtcSpotPriceUsd() {
        try {
            var httpService = new http();
            httpService.setMethod("GET");
            httpService.setUrl("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd");
            var res = httpService.send().getPrefix();
            if ( res.statusCode contains "200" AND isJson(res.fileContent) ) {
                var json = deserializeJSON(res.fileContent);
                if ( structKeyExists(json, "bitcoin") AND structKeyExists(json.bitcoin, "usd") ) {
                    var price = val(json.bitcoin.usd);
                    if ( price > 0 ) return price;
                }
            }
        } catch(any e) {}
        
        // Fallback conservador si falla la API externa ($65,000 USD/BTC)
        return 65000;
    }

    /**
     * Calcula la cantidad exacta de Satoshis para $7.00 USD según la tasa spot actual
     */
    public numeric function calculateSatsForUsd( numeric usdAmount=7.00 ) {
        var btcPrice = getBtcSpotPriceUsd();
        if ( btcPrice <= 0 ) {
            btcPrice = 65000;
        }
        var btcAmount = arguments.usdAmount / btcPrice;
        var sats = round(btcAmount * 100000000);
        if ( sats <= 0 ) {
            sats = 10769; // ~ $7 @ $65k
        }
        return sats;
    }

    /**
     * Genera una Factura Lightning (BOLT11) con expiración de 10 minutos
     */
    public struct function createLightningInvoice( required string reportId, required string documentName, numeric usdAmount=7.00 ) {
        var apiKey = getOpenNodeKey();
        var satsAmount = calculateSatsForUsd(arguments.usdAmount);
        
        // Intentar integración oficial de OpenNode API v1 Charges
        if ( len(trim(apiKey)) > 0 ) {
            try {
                var httpService = new http();
                httpService.setMethod("POST");
                httpService.setUrl("https://api.opennode.com/v1/charges");
                httpService.addParam(type="header", name="Authorization", value=apiKey);
                httpService.addParam(type="header", name="Content-Type", value="application/json");

                var payload = {
                    "amount": usdAmount,
                    "currency": "USD",
                    "description": "AuditFlow AI - Desbloqueo Auditoría: " & left(arguments.documentName, 30),
                    "order_id": arguments.reportId,
                    "ttl": 10,
                    "callback_url": getSystemSetting("APP_URL", "http://localhost:3000") & "/api/webhooks/master?provider=lightning"
                };

                httpService.setBody( serializeJSON(payload) );
                var res = httpService.send().getPrefix();

                if ( res.statusCode contains "200" AND isJson(res.fileContent) ) {
                    var responseStruct = deserializeJSON(res.fileContent);
                    if ( structKeyExists(responseStruct, "data") AND isStruct(responseStruct.data) ) {
                        var charge = responseStruct.data;
                        if ( structKeyExists(charge, "lightning_invoice") AND isStruct(charge.lightning_invoice) AND structKeyExists(charge.lightning_invoice, "payreq") ) {
                            return {
                                "chargeId": structKeyExists(charge, "id") ? charge.id : "ln_" & arguments.reportId,
                                "lightningInvoice": charge.lightning_invoice.payreq,
                                "amountSats": satsAmount,
                                "expiresAt": structKeyExists(charge, "expires_at") ? charge.expires_at : dateAdd("n", 10, now()),
                                "lightningAddress": getLightningAddress()
                            };
                        }
                    }
                }
            } catch(any openNodeErr) {
                systemOutput("[LightningService] Error invocando OpenNode: " & openNodeErr.message, true);
            }
        }

        // Simulación de Factura Lightning BOLT11 ultra-rápida en modo desarrollo
        var mockInvoice = "lnbc70u1p3" & hash(now() & arguments.reportId, "MD5") & "sats1auditflow999";
        return {
            "chargeId": "ln_charge_" & hash(arguments.reportId, "MD5"),
            "lightningInvoice": mockInvoice,
            "amountSats": satsAmount,
            "expiresAt": dateAdd("n", 10, now()),
            "lightningAddress": getLightningAddress()
        };
    }
}
